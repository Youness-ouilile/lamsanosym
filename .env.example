# LAMSANO SYM - Environment Variables
# Copy this file to .env.local and fill in your values

# ============================================
# WhatsApp Configuration
# ============================================
# Your WhatsApp Business number (with country code)
# Format: 1234567890 (no + or - signs)
REACT_APP_WHATSAPP_NUMBER=212612345678

# ============================================
# Website Configuration
# ============================================
REACT_APP_SITE_NAME=LAMSANO SYM
REACT_APP_SITE_DESCRIPTION=Eco-Friendly Upcycled Handmade Denim Accessories & Canvas Art
REACT_APP_SITE_URL=https://lamsano-sym.com
REACT_APP_SITE_KEYWORDS=upcycled,sustainable,eco-friendly,denim,canvas,handmade

# ============================================
# Contact Information
# ============================================
REACT_APP_CONTACT_EMAIL=contact@lamsano-sym.com
REACT_APP_SUPPORT_EMAIL=support@lamsano-sym.com
REACT_APP_CONTACT_PHONE=+212612345678
REACT_APP_CONTACT_ADDRESS=Your City, Morocco

# ============================================
# Social Media
# ============================================
REACT_APP_INSTAGRAM=lamsano_sym
REACT_APP_INSTAGRAM_URL=https://instagram.com/lamsano_sym
REACT_APP_FACEBOOK=lamsano.sym
REACT_APP_FACEBOOK_URL=https://facebook.com/lamsano.sym
REACT_APP_TWITTER=lamsano_sym
REACT_APP_TWITTER_URL=https://twitter.com/lamsano_sym
REACT_APP_LINKEDIN=lamsano-sym
REACT_APP_LINKEDIN_URL=https://linkedin.com/company/lamsano-sym
REACT_APP_WHATSAPP_BUSINESS=212612345678

# ============================================
# Analytics (Optional)
# ============================================
REACT_APP_GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X
REACT_APP_FACEBOOK_PIXEL_ID=1234567890123456

# ============================================
# Payment Gateway (Optional - if implementing later)
# ============================================
# REACT_APP_STRIPE_PUBLIC_KEY=pk_live_xxxxx
# REACT_APP_PAYPAL_CLIENT_ID=xxxxx

# ============================================
# Email Service (Optional - if implementing backend)
# ============================================
# REACT_APP_SENDGRID_API_KEY=SG.xxxxx
# REACT_APP_MAILCHIMP_API_KEY=xxxxx

# ============================================
# Development Settings
# ============================================
REACT_APP_DEBUG=false
REACT_APP_API_URL=http://localhost:5000/api

# ============================================
# Security
# ============================================
# Enable HTTPS only (set to true in production)
REACT_APP_HTTPS_ONLY=false

# ============================================
# Currency & Pricing
# ============================================
REACT_APP_CURRENCY=USD
REACT_APP_CURRENCY_SYMBOL=$
REACT_APP_TAX_RATE=0.20
REACT_APP_SHIPPING_COST=10

# ============================================
# Features Toggles
# ============================================
REACT_APP_ENABLE_REVIEWS=true
REACT_APP_ENABLE_WISHLIST=true
REACT_APP_ENABLE_CUSTOMIZER=true
REACT_APP_ENABLE_NEWSLETTER=true
REACT_APP_ENABLE_ANALYTICS=true

# ============================================
# Brand Settings
# ============================================
REACT_APP_BRAND_NAME=LAMSANO SYM
REACT_APP_BRAND_TAGLINE=Transform Textile Waste into Stunning Art
REACT_APP_BRAND_MISSION=Create sustainable luxury fashion through upcycling
REACT_APP_FOUNDED_YEAR=2024
REACT_APP_TEAM_NAME=ENACTUS / INJAZ Al-Maghrib
